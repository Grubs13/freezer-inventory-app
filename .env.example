# From the Supabase dashboard: Project Settings > API (or `npx supabase status` locally).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used to send invite emails to people who do not have an account yet.
SUPABASE_SECRET_KEY=sb_secret_...
